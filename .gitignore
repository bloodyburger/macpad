*.xcodeproj
*.xcworkspace

# Build output. Local builds go to build.noindex/, which Spotlight skips.
build/
build.noindex/
DerivedData/
*.app
*.dmg

# macOS
.DS_Store

# Swift / SPM
.build/
.swiftpm/

# Local DMG staging from Tools/build.sh and CI artifact downloads
dist/

# Info.plist written by XcodeGen from project.yml on every generate
Resources/Info.plist
Resources/Info *.plist
